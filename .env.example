# ==============================================================================
# Universal Maintenance Agent - Environment Configuration Example
# Copy this file to .env and insert your API keys / settings
# ==============================================================================

# --- Priority 1: Google Gemini (Recommended) ---
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Priority 2: Groq (Open-Weight Fast Inference) ---
# Get your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# --- Priority 3: Local Ollama ---
# Run locally with: ollama serve && ollama pull llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# --- Phase 5: GitHub PR Agent (Optional) ---
# GitHub Personal Access Token (PAT) with repo scope to allow automated branch push & PR creation
# Or install GitHub CLI (gh) and authenticate with `gh auth login`
GITHUB_TOKEN=your_github_personal_access_token_here

# --- General Settings ---
DEBUG=0
